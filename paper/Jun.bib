@article{Shcherbina:2021wz,
	abstract = {We consider 1d random Hermitian {\$}{\$}N{$\backslash$}times N{\$}{\$}block band matrices consisting of {\$}{\$}W{$\backslash$}times W{\$}{\$}random Gaussian blocks (parametrized by {\$}{\$}j,k {$\backslash$}in {$\backslash$}Lambda ={$[$}1,n{$]$}{$\backslash$}cap {$\backslash$}mathbb {\{}Z{\}}{\$}{\$}, {\$}{\$}N=nW{\$}{\$}) with a fixed entry's variance {\$}{\$}J{\_}{\{}jk{\}}=W\^{}{\{}-1{\}}({$\backslash$}delta {\_}{\{}j,k{\}}+{$\backslash$}beta {$\backslash$}Delta {\_}{\{}j,k{\}}){\$}{\$}in each block. Considering the limit {\$}{\$}W, n{$\backslash$}rightarrow {$\backslash$}infty {\$}{\$}, we prove that the behaviour of the second correlation function of such matrices in the bulk of the spectrum, as {\$}{\$}W{$\backslash$}gg {$\backslash$}sqrt{\{}N{\}}{\$}{\$}, is determined by the Wigner--Dyson statistics. The method of the proof is based on the rigorous application of supersymmetric transfer matrix approach developed in Shcherbina and Shcherbina (J Stat Phys 172:627--664, 2018).},
