@article{LANDON20191137,
title = {Fixed energy universality of Dyson Brownian motion},
journal = {Advances in Mathematics},
volume = {346},
pages = {1137-1332},
year = {2019},
issn = {0001-8708},
doi = {https://doi.org/10.1016/j.aim.2019.02.010},
url = {https://www.sciencedirect.com/science/article/pii/S000187081930101X},
author = {Benjamin Landon and Philippe Sosoe and Horng-Tzer Yau},
keywords = {Random matrices, Universality},
abstract = {We consider Dyson Brownian motion for classical values of β with deterministic initial data V. We prove that the local eigenvalue statistics coincide with the GOE/GUE in the fixed energy sense after time t≳1/N if the density of states of V is bounded above and below down to scales η≪t in a window of size L≫t. Our results imply that fixed energy universality holds for essentially any random matrix ensemble for which averaged energy universality was previously known. Our methodology builds on the homogenization theory developed in [16] which reduces the microscopic problem to a mesoscopic problem. As an auxiliary result we prove a mesoscopic central limit theorem for linear statistics of various classes of test functions for classical Dyson Brownian motion.}
}
@article{yang2021delocalization,
	abstract = {We consider Hermitian random band matrices {\$}{\$}H=(h{\_}{\{}xy{\}}){\$}{\$}defined on the d-dimensional discrete torus {\$}{\$}({$\backslash$}mathbb {\{}Z{\}}/L{$\backslash$}mathbb {\{}Z{\}})\^{}d{\$}{\$}. The entries {\$}{\$}h{\_}{\{}xy{\}}{\$}{\$}are independent (subject to the Hermitian symmetry condition) centered complex Gaussian random variables, with variances {\$}{\$}s{\_}{\{}xy{\}}={\{}{$\backslash$}mathbb {\{}E{\}}{\}}{$|$}h{\_}{\{}xy{\}}{$|$}\^{}2{\$}{\$}. The variance matrix {\$}{\$}S=(s{\_}{\{}xy{\}}){\$}{\$}exhibits a banded structure so that {\$}{\$}s{\_}{\{}xy{\}}{\$}{\$}is negligible when the distance {\$}{\$}{$|$}x-y{$|$}{\$}{\$}exceeds the band width W. In dimensions {\$}{\$}d{$\backslash$}geqslant 8{\$}{\$}, we prove that, provided {\$}{\$}W{$\backslash$}geqslant L\^{}{\{}{$\backslash$}varepsilon {\}}{\$}{\$}for some small constant {\$}{\$}{\{}{$\backslash$}varepsilon {\}}>0{\$}{\$}, the bulk eigenvectors of H are delocalized, in the sense that their localization lengths are comparable to the system size L. Denote by {\$}{\$}G(z)=(H-z)\^{}{\{}-1{\}}{\$}{\$}the Green's function of H. For spectral parameters with {\$}{\$}{\{}{\{}{$\backslash$},{$\backslash$}textrm{\{}Im{\}}{$\backslash$},{\}}{\}}z{$\backslash$}gg W\^{}2/L\^{}2{\$}{\$}, we establish a widely used criterion in physics for quantum diffusion in this model. Specifically, we show that the leading term in the Fourier transform (with respect to {\$}{\$}x-y{\$}{\$}) of {\$}{\$}{$\backslash$}mathbb {\{}E{\}}{$|$}G{\_}{\{}xy{\}}(z){$|$}\^{}2{\$}{\$}takes the form {\$}{\$}({\{}{\{}{$\backslash$},{$\backslash$}textrm{\{}Im{\}}{$\backslash$},{\}}{\}}z + a(p))\^{}{\{}-1{\}}{\$}{\$}for some quadratic function a(p) of p, where p is the Fourier variable. Our approach is based on a delicate expansion of the T-variable, {\$}{\$}{$\backslash$}sum {\_}{\{}{$\backslash$}alpha {\}}s{\_}{\{}x{$\backslash$}alpha {\}}{$|$}G{\_}{\{}{$\backslash$}alpha y{\}}{$|$}\^{}2{\$}{\$}, which requires a self-energy renormalization up to an error of order {\$}{\$}W\^{}{\{}-K{\}}{\$}{\$}, for any arbitrarily large constant K independent of W and L. Furthermore, our method naturally extends to non-Gaussian band matrices.},
	author = {Yang, Fan and Yau, Horng-Tzer and Yin, Jun},
