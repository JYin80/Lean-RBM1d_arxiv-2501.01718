@article{Hislop:2022td,
	abstract = {We study the local eigenvalue statistics {\$}{\$}{$\backslash$}xi {\_}{\{}{$\backslash$}omega ,E{\}}\^{}N{\$}{\$}associated with the eigenvalues of one-dimensional, {\$}{\$}(2N+1) {$\backslash$}times (2N+1){\$}{\$}random band matrices with independent, identically distributed, real random variables and band width growing as {\$}{\$}N\^{}{$\backslash$}alpha {\$}{\$}, for {\$}{\$}0< {$\backslash$}alpha < {$\backslash$}frac{\{}1{\}}{\{}2{\}}{\$}{\$}. We consider the limit points associated with the random variables {\$}{\$}{$\backslash$}xi {\_}{\{}{$\backslash$}omega ,E{\}}\^{}N {$[$}I{$]$}{\$}{\$}, for {\$}{\$}I {$\backslash$}subset {$\backslash$}mathbb {\{}R{\}}{\$}{\$}, and {\$}{\$}E {$\backslash$}in (-2,2){\$}{\$}. For random band matrices with Gaussian distributed random variables and for {\$}{\$}0 {$\backslash$}le {$\backslash$}alpha < {$\backslash$}frac{\{}1{\}}{\{}7{\}}{\$}{\$}, we prove that this family of random variables has nontrivial limit points for almost every {\$}{\$}E {$\backslash$}in (-2,2){\$}{\$}, and that these limit points are Poisson distributed with positive intensities. The proof is based on an analysis of the characteristic functions of the random variables {\$}{\$}{$\backslash$}xi {\_}{\{}{$\backslash$}omega ,E{\}}\^{}N {$[$}I{$]$}{\$}{\$}and associated quantities related to the intensities, as N tends towards infinity, and employs known localization bounds of (Peled et al. in Int. Math. Res. Not. IMRN 4:1030--1058, 2019, Schenker in Commun Math Phys 290:1065--1097, 2009), and the strong Wegner and Minami estimates (Peled et al. in Int. Math. Res. Not. IMRN 4:1030--1058, 2019). Our more general result applies to random band matrices with random variables having absolutely continuous distributions with bounded densities. Under the hypothesis that the localization bounds hold for {\$}{\$}0< {$\backslash$}alpha < {$\backslash$}frac{\{}1{\}}{\{}2{\}}{\$}{\$}, we prove that any nontrivial limit points of the random variables {\$}{\$}{$\backslash$}xi {\_}{\{}{$\backslash$}omega ,E{\}}\^{}N {$[$}I{$]$}{\$}{\$}are distributed according to Poisson distributions.},
	author = {Hislop, Peter D. and Krishna, M.},
	date = {2022-04-19},
	date-added = {2022-09-09 02:12:14 -0700},
	date-modified = {2022-09-09 02:12:14 -0700},
	doi = {10.1007/s10955-022-02923-5},
	id = {Hislop2022},
	issn = {1572-9613},
	journal = {Journal of Statistical Physics},
	number = {3},
	pages = {26},
	title = {On the Local Eigenvalue Statistics for Random Band Matrices in the Localization Regime},
	url = {https://doi.org/10.1007/s10955-022-02923-5},
	volume = {187},
	year = {2022},
	bdsk-url-1 = {https://doi.org/10.1007/s10955-022-02923-5}}

 

